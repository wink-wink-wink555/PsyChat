# =============================================================================
# 心理咨询伴侣 - 环境变量配置模板
# 复制此文件为 .env 并填入你的 API 密钥
# =============================================================================

# DeepSeek API 配置
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 Embedding API 配置
# 获取地址: https://bailian.console.aliyun.com/
# 注意: 同一个API KEY同时支持Embedding和TTS服务
ALIBABA_API_KEY=your_alibaba_api_key_here
EMBEDDING_MODEL=text-embedding-v4

# 阿里云百炼 TTS 配置（使用与Embedding相同的API KEY）
# 语音合成功能开关
TTS_ENABLED=True
# 语音模型（cosyvoice-v3-flash/cosyvoice-v3-plus/cosyvoice-v2）
TTS_MODEL=cosyvoice-v3-flash
# 音色选择（longanyang/longxiaochun/longjing/longxuanxuan）
TTS_VOICE=longanyang
# 语速（0.5-2.0，1为正常语速）
TTS_RATE=1

